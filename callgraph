# callgraph - orchestration wrapper.
#
# This script contains no analysis logic.  It decides whether the tracer needs
# static call-graph facts, asks callgraph-disasm for them, and passes the
# resulting JSON path to the tracer with --static-graph.  The tracer and the
# generator are ordinary programs; this wrapper never gates or hides them.

set -euo pipefail

# Temporary facts are removed on every exit path, including signals.  When a
# temporary directory exists the wrapper waits for the child instead of
# exec'ing it, so this trap gets a chance to run.
tmp_dir=

cleanup() {
    if [[ -n $tmp_dir ]]; then
        rm -rf -- "$tmp_dir"
        tmp_dir=
    fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# The binaries are installed next to the real script.  Resolve this script
# through symlinks (and through PATH when invoked by name) so a symlinked
# wrapper still finds its own directory.
resolve_self_dir() {
    local self=${BASH_SOURCE[0]}
    if [[ $self != */* ]]; then
        local found
        found=$(command -v -- "$self" 2>/dev/null) || true
        if [[ -n $found ]]; then
            self=$found
        fi
    fi
    while [[ -L $self ]]; do
        local link
        link=$(readlink -- "$self") || break
        if [[ $link != /* ]]; then
            link=$(dirname -- "$self")/$link
        fi
        self=$link
    done
    cd -- "$(dirname -- "$self")" && pwd -P
}

self_dir=$(resolve_self_dir)
callgraph_run=${CALLGRAPH_RUN:-"$self_dir/callgraph-run"}
callgraph_attach=${CALLGRAPH_ATTACH:-"$self_dir/callgraph-attach"}
callgraph_export=${CALLGRAPH_EXPORT:-"$self_dir/callgraph-export"}
callgraph_disasm=${CALLGRAPH_DISASM:-"$self_dir/callgraph-disasm"}

usage() {
    cat <<'EOF'
usage: callgraph <command> [<args>]

These are the available commands:

   run       trace a program launched by callgraph
   attach    trace a running process
   export    convert a trace or render a static call graph
   disasm    emit static facts for an ELF module

Facts are generated for run/attach --trace-depth <n> (n >= 0) or
--return-mode=ret, and for export --static.  Pass --static-graph <file> to
reuse facts produced by callgraph disasm; the wrapper then generates nothing.
Generated facts are temporary and removed when callgraph exits.

--all-modules is forwarded to callgraph disasm as well as to the tracer, so
the facts cover the target's static DT_NEEDED closure.  Modules opened with
dlopen have no facts and degrade with a tracer warning.

Run 'callgraph <command> --help' for details.
EOF
}

die() {
    printf 'callgraph: %s\n' "$*" >&2
    exit 1
}

if (($# == 0)); then
    usage >&2
    exit 2
fi

case $1 in
    -h | --help | help)
        usage
        exit 0
        ;;
    --version)
        "$callgraph_run" --version
        "$callgraph_attach" --version
        "$callgraph_export" --version
        "$callgraph_disasm" --version
        exit 0
        ;;
    run | attach | export | disasm) ;;
    *)
        usage >&2
        exit 2
        ;;
esac

mode=$1
shift

if [[ $mode == disasm ]]; then
    [[ -x $callgraph_disasm ]] || die "callgraph-disasm not found at $callgraph_disasm"
    exec "$callgraph_disasm" "$@"
fi

# Help and version must not trigger fact generation.  Forward them straight to
# the mode's own program so it prints its own page.
help_only=0
for arg in "$@"; do
    case $arg in
        --) break ;;
        -h | --help | --version) help_only=1 ;;
    esac
done

# Scans arguments for tracer flags that need facts.  Sets trace_depth,
# return_mode, all_modules and user_static_graph.
scan_flags() {
    trace_depth=
    return_mode=
    all_modules=0
    user_static_graph=0
    local args=("$@")
    local i arg
    for ((i = 0; i < ${#args[@]}; i++)); do
        arg=${args[i]}
        [[ $arg == -- ]] && break
        case $arg in
            --trace-depth=*) trace_depth=${arg#*=} ;;
            --trace-depth) trace_depth=${args[i + 1]:-} ;;
            --return-mode=*) return_mode=${arg#*=} ;;
            --return-mode) return_mode=${args[i + 1]:-} ;;
            --all-modules) all_modules=1 ;;
            --static-graph=*) user_static_graph=1 ;;
            --static-graph) user_static_graph=1 ;;
        esac
    done
}

needs_graph() {
    [[ $return_mode == ret ]] && return 0
    [[ -n $trace_depth && $trace_depth != -1 ]] && return 0
    return 1
}

resolve_program() {
    local program=$1
    if [[ $program == */* ]]; then
        printf '%s\n' "$program"
        return
    fi
    command -v -- "$program" 2>/dev/null || printf '%s\n' "$program"
}

# Prints the executable path for a PID, or fails.
pid_exe() {
    local pid=$1
    [[ -n $pid ]] || die "attach requires -p PID"
    [[ -e /proc/$pid/exe ]] || die "cannot read /proc/$pid/exe"
    readlink -f -- "/proc/$pid/exe"
}

generate_facts() {
    local module=$1
    [[ -n $module ]] || die "cannot determine the module to analyze"
    [[ -x $callgraph_disasm ]] || die "callgraph-disasm not found at $callgraph_disasm"

    tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/callgraph-facts.XXXXXX")
    local facts=$tmp_dir/facts.json

    local args=()
    ((all_modules)) && args+=(--all-modules)
    args+=("$module" -o "$facts")

    "$callgraph_disasm" "${args[@]}"
    facts_path=$facts
}

# Runs the child and preserves its status.  Without temporary facts this is a
# plain exec (one process hop); with them the wrapper stays alive so the EXIT
# trap can remove the directory.
run_and_exit() {
    if [[ -z $tmp_dir ]]; then
        exec "$@"
    fi
    local status=0
    "$@" || status=$?
    exit "$status"
}

facts_path=

if [[ $mode == export ]]; then
    if ((help_only)); then
        exec "$callgraph_export" "$@"
    fi
    scan_flags "$@"
    # Detect the export sub-mode.
    export_static=0
    for arg in "$@"; do
        case $arg in
            --static) export_static=1 ;;
            --otel | --flame) export_static=0 ;;
        esac
    done

    if ((export_static)); then
        # Find the module positional while skipping option values.
        module=
        expect_value=0
        for arg in "$@"; do
            if ((expect_value)); then
                expect_value=0
                continue
            fi
            case $arg in
                -o | --output | --root-scope | --static-graph)
                    expect_value=1
                    ;;
                -*) ;;
                *) module=$arg ;;
            esac
        done

        if ((user_static_graph)); then
            exec "$callgraph_export" "$@"
        fi

        generate_facts "$module"

        # Rebuild the argument list without the positional MODULE: the tracer
        # takes the facts path, not an ELF path.
        rebuilt=()
        expect_value=0
        for arg in "$@"; do
            if ((expect_value)); then
                expect_value=0
                rebuilt+=("$arg")
                continue
            fi
            case $arg in
                -o | --output | --root-scope | --static-graph)
                    expect_value=1
                    rebuilt+=("$arg")
                    ;;
                --all-modules)
                    # Facts already cover the closure; the tracer has no
                    # such flag in static export mode.
                    ;;
                -*)
                    rebuilt+=("$arg")
                    ;;
                *)
                    # Drop the positional MODULE.
                    ;;
            esac
        done
        run_and_exit "$callgraph_export" "${rebuilt[@]}" \
            --static-graph "$facts_path"
    fi

    exec "$callgraph_export" "$@"
fi

# run / attach
scan_flags "$@"

if [[ $mode == run ]]; then
    mode_bin=$callgraph_run
else
    mode_bin=$callgraph_attach
fi

if ((help_only)); then
    exec "$mode_bin" "$@"
fi

if ((user_static_graph)) || ! needs_graph; then
    exec "$mode_bin" "$@"
fi

if [[ $mode == run ]]; then
    module=
    saw_separator=0
    args=("$@")
    for ((i = 0; i < ${#args[@]}; i++)); do
        if [[ ${args[i]} == -- ]]; then
            saw_separator=1
            module=${args[i + 1]:-}
            break
        fi
    done
    ((saw_separator)) || die "run requires '-- PROGRAM' to locate the target"
    module=$(resolve_program "$module")
else
    pid=
    args=("$@")
    for ((i = 0; i < ${#args[@]}; i++)); do
        case ${args[i]} in
            -p | --pid) pid=${args[i + 1]:-} ;;
            --pid=*) pid=${args[i]#*=} ;;
        esac
    done
    module=$(pid_exe "$pid")
fi
generate_facts "$module"

if [[ $mode == run ]]; then
    # --static-graph must precede the "--" separator.
    final=()
    inserted=0
    for arg in "$@"; do
        if [[ $arg == -- ]] && ((inserted == 0)); then
            final+=(--static-graph "$facts_path")
            inserted=1
        fi
        final+=("$arg")
    done
    run_and_exit "$callgraph_run" "${final[@]}"
fi

run_and_exit "$callgraph_attach" "$@" --static-graph "$facts_path"
